{
  "name": "pathback-monorepo",
  "version": "1.0.0",
  "description": "PathBack — Finding a safer path back home. A Consent-First Multimodal AI Platform for Missing-Person Investigation Support",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "npm run seed --prefix backend"
  },
  "keywords": [
    "multimodal-ai",
    "investigation",
    "consent-first",
    "missing-persons",
    "claude-3-5-sonnet",
    "responsible-ai",
    "pattern-recognition"
  ],
  "author": "SETHU Engineering Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
