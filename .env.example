# ==================================================
# PathBack Platform Configuration (.env.example)
# Tagline: Finding a safer path back home.
# ==================================================

# Server
PORT=5000
NODE_ENV=development

# Database (Leave empty or set to mongodb-memory:// to use embedded in-memory MongoDB for local dev)
MONGODB_URI=mongodb://localhost:27017/pathback

# Authentication (JWT)
JWT_ACCESS_SECRET=hRrPReOBYRGXksT4jrjOJpzT9lCpfM981k47U8PPSq8pxetfPZwCTQYpyelmENUyHCLUxLeWMA1G4B3AqcPv6Q==
JWT_REFRESH_SECRET=pathback_secure_jwt_refresh_token_secret_replace_in_production_2026

# Supabase.ai Integration (Storage, Database & Vector AI Embeddings)
# Get your project URL and keys from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://ftnsfbidpvolmbxvvzmt.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=case-evidence

# Frontend Client Supabase Variables (for direct browser uploads if needed)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Anthropic Claude Multimodal AI (Backend Only)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# SMS OTP Provider (options: console_mock, twilio, fast2sms)
SMS_PROVIDER=console_mock
SMS_API_KEY=
SMS_FROM_NUMBER=+18005550199

# Storage Provider (options: local, cloudinary, supabase)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client Application URL for CORS
CLIENT_URL=http://localhost:3000

# Development and Demo Modes
DEV_OTP_MODE=true
DEMO_MODE=true
